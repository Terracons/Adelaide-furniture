# ---------------------------------------------------------------
#  Adelaide Furniture - server + database settings
#  Copy to .env.local for local dev. On Vercel, set these in
#  Project - Settings - Environment Variables.
# ---------------------------------------------------------------

# --- Public (baked into the client bundle, safe to expose) ------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CURRENCY=AUD
NEXT_PUBLIC_CURRENCY_SYMBOL=$

# --- Neon Postgres ----------------------------------------------
# Get this from the Neon dashboard (or Vercel's Neon integration).
# Use the POOLED connection string ("-pooler") for serverless.
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Auth (server only, NEVER expose) ---------------------------
# 32+ random chars. Generate: openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string

# --- Vercel Blob (image uploads from the admin panel) -----------
# Auto-added when you connect a Blob store in the Vercel dashboard.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
