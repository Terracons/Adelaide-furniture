# ---------------------------------------------------------------
#  Adelaide Furniture - build-time settings
#  Copy to .env.local before running `npm run dev` or `npm run build`.
#  These are baked into the static build, so no secrets belong here.
# ---------------------------------------------------------------

# Your live domain - used for canonical URLs, sitemap.xml and social previews
NEXT_PUBLIC_SITE_URL=https://adelaidefurniture.com.au

# Currency shown throughout the storefront
NEXT_PUBLIC_CURRENCY=AUD
NEXT_PUBLIC_CURRENCY_SYMBOL=$
