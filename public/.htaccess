# ==========================================================================
#  Adelaide Furniture - Apache config for Hostinger shared hosting
#  Upload this file together with the contents of /out into public_html
# ==========================================================================

# --- Force HTTPS ----------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# --- Clean URLs -----------------------------------------------------------
# The site is exported with trailing slashes, so /shop/ resolves to
# /shop/index.html automatically. These rules cover the odd link that
# arrives without the slash, and send anything unmatched to the 404 page.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Never rewrite real files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # /shop -> /shop/index.html
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*[^/])$ /$1/ [R=301,L]

  # /shop.html style direct hits
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+)$ /$1.html [L]
</IfModule>

ErrorDocument 404 /404.html

# --- Compression ----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Caching --------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/jpeg    "access plus 1 year"
  ExpiresByType image/png     "access plus 1 year"
  ExpiresByType image/webp    "access plus 1 year"
  ExpiresByType text/css      "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html     "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Next.js fingerprints its own assets, so they are safe to cache forever
  <FilesMatch "\.(js|css|svg|woff2|jpg|png|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Basic hardening
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# --- MIME types -----------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType application/font-woff2 .woff2
</IfModule>

# --- Directory listing off ------------------------------------------------
Options -Indexes
